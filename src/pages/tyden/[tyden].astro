---
// /tyden/<id>/: týden cvičení v duchu Zkus to žít (Stoický týden). Skládá se z dat v src/content/tydny/<id>.yaml;
// dny, Hotovo a deník obstará ostrov Tyden.svelte. Kontrola dat (citáty, osoby, prameny) zastaví sestavení.
import { getCollection, type CollectionEntry } from 'astro:content';
import Zakladni from '../../layouts/Zakladni.astro';
import Citat from '../../components/ui/Citat.astro';
import HlavickaStranky from '../../components/stranka/HlavickaStranky.astro';
import Tyden from '../../components/ostrovy/Tyden.svelte';
import { citatyPodleId, osoba, osoby, pramenyPodleId } from '../../lib/data';
import { adresaTydne, kontrolaTydne } from '../../lib/tydny';
import { odstavce, radek } from '../../lib/bloky';
import { nezlomitelne } from '../../lib/sazba.js';
import { adresyStranek } from '../../lib/stranky-typu';

export async function getStaticPaths() {
  const tydny = await getCollection('tydny');
  const znam = { citaty: new Set(citatyPodleId.keys()), prameny: new Set(pramenyPodleId.keys()), osoby: new Set(osoby.keys()) };
  const chyby = tydny.flatMap((t) => kontrolaTydne(t.id, t.data, znam));
  if (chyby.length) throw new Error(`Týdny neprošly kontrolou:\n- ${chyby.join('\n- ')}`);
  return tydny.map((t) => ({ params: { tyden: t.id }, props: { tyden: t } }));
}
interface Props { tyden: CollectionEntry<'tydny'> }
const { tyden } = Astro.props;
const t = tyden.data;
const odkaz = adresaTydne(tyden.id);
// Drobečky přes stránku směru (Stoický týden → Stoicismus), dokud ji směr má; jinak rovnou z Lidí a směrů.
const smer = t.smer ? (await getCollection('smery')).find((s) => s.id === t.smer) : undefined;
if (t.smer && !smer) throw new Error(`Týden „${tyden.id}“: směr „${t.smer}“ není v src/content/smery.`);
const adresaSmeru = t.smer ? (await adresyStranek()).smer(t.smer) : undefined;
const drobecky = [
  { text: 'Lidé a směry', href: '/lide/' },
  ...(smer && adresaSmeru ? [{ text: smer.data.nazev, href: adresaSmeru }] : []),
  { text: t.nazev },
];
// Pruh pod názvem (revize R, otázka 3): „Sedm dní, sedm cvičení“; počet slovem, jak se řekne nahlas.
const SLOVY = ['', 'Jeden', 'Dva', 'Tři', 'Čtyři', 'Pět', 'Šest', 'Sedm', 'Osm', 'Devět', 'Deset'];
const n = t.dny.length;
const slovo = SLOVY[n];
const pruh = slovo ? `${slovo} ${n < 5 ? 'dny' : 'dní'}, ${slovo.toLocaleLowerCase('cs')} cvičení` : `${n} dní`;
const dny = t.dny.map((d) => {
  const c = d.citat ? citatyPodleId.get(d.citat)! : undefined;
  return {
    cislo: d.cislo,
    nazev: nezlomitelne(d.nazev),
    kdo: osoba(d.osoba).jmeno,
    doba: nezlomitelne(d.doba),
    text: odstavce(d.text),
    ...(c ? { citat: { cesky: nezlomitelne(c.cesky), autor: c.autor, dilo: c.dilo, misto: c.misto } } : {}),
    ...(c && d.poCitatu ? { poCitatu: odstavce(d.poCitatu) } : {}),
    mez: radek(d.mez),
    ...(d.odkaz ? { odkaz: { href: d.odkaz.href, text: nezlomitelne(d.odkaz.text) } } : {}),
    ...(d.psani ? { psani: d.psani } : {}),
  };
});
---
<Zakladni obdobi={t.obdobi}
  titulek={t.nazev}
  popis={`${t.vstup}.`}
  sekce="lide"
  drobecky={drobecky}
>
  <article class={`tyden stranka obdobi-${t.obdobi}`}>
    <div class="tyden__hlava ctenarsky">
      <HlavickaStranky obdobi={t.obdobi} nadtitulek={`Zkus to žít · ${n} ${n < 5 ? 'dny' : 'dní'}`} titulek={t.nazev} pruh={pruh} perex={t.uvod} />
      <div class="cisty-list tyden__namitka">
        <p class="namitka" set:html={radek(t.namitka.text)} />
        {t.namitka.citat && <Citat id={t.namitka.citat} kompaktni />}
        <p class="pravidla t-ovladani" set:html={radek(t.pravidla)} />
      </div>
    </div>
    <div class="ctenarsky">
      <Tyden client:load id={tyden.id} nazev={t.nazev} odkaz={odkaz} dny={dny} />
    </div>
  </article>
</Zakladni>

<style>
  .tyden { padding-bottom: var(--s-8); }
  /* Středová osa jako u cesty a profilu. */
  .tyden :global(.ctenarsky) { margin-inline: auto; }
  /* Spojení (revize R, otázka 3): titulek s pruhem jako stránky z dat, námitka na čistém listu, dny jako lístky. */
  /* Titulek v čtenářském sloupci: jméno ve stupni h1, aby se „Stoický týden.“ vešlo na notebooku na jeden řádek. */
  .tyden__hlava :global(.titulek__jmeno) { font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: var(--ls-h1); }
  .tyden__namitka { margin-top: var(--s-2); margin-bottom: var(--s-7); }
  .namitka { margin: 0; }
  .namitka + :global(.citat) { margin-top: var(--s-2); }
  .pravidla { margin: var(--s-5) 0 0; padding-top: var(--s-3); border-top: 1.5px dashed var(--tuzka); color: var(--ink); }
</style>
