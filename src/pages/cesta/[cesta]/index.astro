---
// Přehled cesty: otázka, úvod, Začít / Pokračovat a kroky s tím, co student prošel.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Zakladni from '../../../layouts/Zakladni.astro';
import PostupCesty from '../../../components/cesta/PostupCesty.svelte';
import Mince from '../../../components/ui/Mince.astro';
import { osoba } from '../../../lib/data';
import { krokyCesty, adresaKroku, poradiDalsichCest } from '../../../lib/cesty';
import { adresaOtazky } from '../../../lib/otazky';
import { adresaStranekOsob, medailonky } from '../../../lib/stranky-osob';
import { nezlomitelne } from '../../../lib/sazba.js';
import { adresaTydne } from '../../../lib/tydny';

export async function getStaticPaths() {
  const cesty = await getCollection('cesty');
  const kroky = await getCollection('kroky');
  return cesty.map((c) => ({
    params: { cesta: c.id },
    props: { cesta: c, kroky: krokyCesty(kroky.map((k) => k.data), c.id) },
  }));
}
interface Props { cesta: CollectionEntry<'cesty'>; kroky: { krok: number; nazev: string }[] }
const { cesta, kroky } = Astro.props;
const { Content } = await render(cesta);
const c = cesta.data;
const lide = c.filozofove.map(osoba);
// Odkaz na stránku osobnosti jen tam, kde stránka je (Lucretius v cestě 8 ji nemá); Hipparchia vede na společný profil.
const adresa = await adresaStranekOsob();
// Kam dál: jeden odkaz na stránku, i když na ní stojí dva filozofové cesty („Kratés a Hipparchia: celý příběh“).
// Medailonek je stránka z dat (dvě věty), ne „celý příběh“: odkaz to říká.
const profilyCesty: { href: string; jmena: string; medailonek: boolean }[] = [];
for (const o of lide) {
  const href = adresa(o.id);
  if (!href) continue;
  const p = profilyCesty.find((x) => x.href === href);
  if (p) p.jmena += ` a ${o.jmeno}`;
  else profilyCesty.push({ href, jmena: o.jmeno, medailonek: medailonky.includes(o.id) });
}
const otazky = await getCollection('otazky');
const otazka = otazky.find((o) => o.data.cislo === c.otazka);
const odkazOtazky = otazka ? adresaOtazky(otazka.id, otazka.data) : undefined;
// Další cesta: stránka ukáže první, kterou student podle deníku ještě nemá hotovou (skript dole); bez deníku
// a bez JavaScriptu první v pořadí. Nejdřív cesty téže otázky (revize antiky, O, nález 9).
const dalsi = poradiDalsichCest(cesta.id, (await getCollection('cesty')).map((x) => ({ slug: x.id, ...x.data })))
  .map((x) => ({ slug: x.slug, nazev: x.nazev }));
const seznam = kroky.map((k) => ({ n: k.krok, nazev: k.nazev, href: adresaKroku(cesta.id, k.krok) }));
// Týdny cvičení, které se po této cestě nabízejí (pole nabizet.cesty v src/content/tydny/<id>.yaml).
const tydny = (await getCollection('tydny')).filter((t) => t.data.nabizet.cesty.includes(cesta.id));
const malym = (s: string) => s.charAt(0).toLocaleLowerCase('cs') + s.slice(1);
---
<Zakladni
  titulek={c.nazev}
  popis={c.vstup}
  sekce="otazky"
  drobecky={[
    { text: 'Otázky', href: '/otazky/' },
    ...(otazka ? [{ text: otazka.data.otazka, href: odkazOtazky }] : []),
    { text: 'Cesta' },
  ]}
>
  <article class={`cesta stranka obdobi-${c.obdobi}`}>
    <header class="cesta__hlava ctenarsky">
      <p class="t-nadtitulek nadtitulek">Cesta{c.minut && <> · asi {c.minut} minut</>} · {kroky.length} kroků</p>
      <h1 class="t-h1">{c.nazev}</h1>
      <p class="t-perex">{nezlomitelne(c.vstup)}</p>
      <p class="lide t-ovladani">
        {lide.map((o) => <span class="clovek"><Mince osoba={o} varianta="tint" velikost={36} /> {adresa(o.id) ? <a href={adresa(o.id)}>{o.jmeno}</a> : <span>{o.jmeno}</span>}</span>)}
      </p>
    </header>
    <div class="ctenarsky uvod"><Content /></div>
    <section class="ctenarsky" aria-labelledby="kroky-nadpis">
      <PostupCesty client:load varianta="prehled" slug={cesta.id} nazev={c.nazev} kroky={seznam} />
    </section>
    <section class="ctenarsky kam-dal" id="hotovo" aria-labelledby="kam-dal-nadpis">
      <h2 class="t-h3" id="kam-dal-nadpis">Kam dál</h2>
      <ul>
        {dalsi[0] && <li data-dalsi-cesta={JSON.stringify(dalsi)}><a href={`/cesta/${dalsi[0].slug}/`}>Další cesta: <span data-dalsi-nazev>{dalsi[0].nazev}</span></a></li>}
        {profilyCesty.map((p) => <li><a href={p.href}>{p.jmena}: {p.medailonek ? 'medailonek' : 'celý příběh'}</a></li>)}
        {c.mapa && <li><a href={`/mapa/?rok=${c.mapa.rok}&osoba=${c.mapa.osoba}`}>Mapa a čas: {c.mapa.text}</a></li>}
        {otazka && <li><a href={odkazOtazky}>Velká otázka {otazka.data.cislo}: {otazka.data.otazka}</a></li>}
        {tydny.map((t) => <li><a href={adresaTydne(t.id)}>{t.data.nazev}: {malym(t.data.vstup)}</a></li>)}
      </ul>
    </section>
  </article>
</Zakladni>

<script>
  import { nacti } from '../../../lib/denik';
  import { cestaHotova } from '../../../lib/cesty';
  // Další cesta podle deníku: první z pořadí, kterou student nemá hotovou. Když má hotové všechny, odkaz zmizí.
  const li = document.querySelector<HTMLElement>('[data-dalsi-cesta]');
  if (li) {
    try {
      const poradi = JSON.parse(li.dataset.dalsiCesta ?? '[]') as { slug: string; nazev: string }[];
      const postup = nacti().cesty;
      const volna = poradi.find((c) => !cestaHotova(postup[c.slug]));
      if (!volna) li.hidden = true;
      else {
        li.querySelector('a')!.setAttribute('href', `/cesta/${volna.slug}/`);
        li.querySelector('[data-dalsi-nazev]')!.textContent = volna.nazev;
      }
    } catch { /* bez deníku zůstane první v pořadí */ }
  }
</script>

<style>
  .cesta { padding-bottom: var(--s-8); }
  /* Středová osa jako u kroků, profilu a otázky: sloupec uprostřed, ne u levého okraje. */
  .cesta :global(.ctenarsky) { margin-inline: auto; }
  .cesta__hlava { padding: var(--s-6) 0 var(--s-4); }
  .nadtitulek { margin: 0 0 var(--s-3); color: var(--pc); }
  h1 { margin-bottom: var(--s-4); }
  .lide { display: flex; flex-wrap: wrap; gap: var(--s-4); margin: 0; }
  .clovek { display: inline-flex; align-items: center; gap: var(--s-2); }
  .uvod { margin-bottom: var(--s-6); }
  .kam-dal { margin-top: var(--s-8); padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  .kam-dal ul { margin: var(--s-3) 0 0; padding-left: var(--s-5); font-family: var(--font-sans); font-size: var(--fs-ovladani-l); }
  .kam-dal li { padding: var(--s-2) 0; }
</style>
