---
// Otázky: deset velkých otázek atlasu a cesty, které k nim vedou.
import { getCollection } from 'astro:content';
import Zakladni from '../../layouts/Zakladni.astro';
import Ikona from '../../components/ui/Ikona.astro';
import CestaKarta from '../../components/cesta/CestaKarta.astro';
import { maStranku } from '../../lib/otazky';
import { cestyOtazky } from '../../lib/vstupy';
const otazky = (await getCollection('otazky')).sort((a, b) => a.data.cislo - b.data.cislo);
const cesty = (await getCollection('cesty')).map((c) => ({ slug: c.id, ...c.data }));
---
<Zakladni titulek="Otázky" sekce="otazky" drobecky={[{ text: 'Otázky' }]}>
  <div class="stranka">
    <header class="hlava bez-obdobi">
      <div class="titulek"><div class="titulek__list"><h1 class="titulek__jmeno">Deset velkých otázek.</h1></div></div>
      <p class="t-perex perex">Na tyhle otázky odpovídá každá doba po svém. U otázek najdeš místo pro svou první odpověď, hlasy filozofů a cesty, které k nim vedou.</p>
      <a class="uvodni" href="/co-je-filozofie/">
        <span class="t-nadtitulek uvodni__nad">Na začátek</span>
        <span class="uvodni__nazev">Co je filozofie?</span>
        <Ikona id="dal" velikost={20} />
      </a>
    </header>
    <ol class="otazky">
      {otazky.map((o) => (
        <li id={o.id}>
          <span class="cislo t-letopocet">{o.data.cislo}</span>
          <span class="text">
            {maStranku(o.data)
              ? <a class="t-h3" href={`/otazka/${o.id}/`}>{o.data.otazka}</a>
              : <span class="t-h3">{o.data.otazka}</span>}
            <span class="t-popisek">{o.data.disciplina}</span>
            {cestyOtazky(o.data.cislo, cesty).length > 0 && (
              <ul class="cesty" aria-label={`Cesty k otázce ${o.data.cislo}`}>
                {cestyOtazky(o.data.cislo, cesty).map((c) => (
                  <li><CestaKarta slug={c.slug} maly class="cesta" /></li>
                ))}
              </ul>
            )}
          </span>
        </li>
      ))}
    </ol>
  </div>
</Zakladni>

<style>
  .hlava { max-width: 960px; padding: var(--s-6) 0 var(--s-6); }
  .perex { max-width: var(--ctenarsky-sloupec); margin: var(--s-5) 0 0; }
  /* Úvod jako lístek k vzetí, ne rámeček. */
  .uvodni {
    display: inline-flex; align-items: center; gap: var(--s-3); min-height: var(--dotyk); margin-top: var(--s-5); padding: 12px 18px;
    background: var(--listek); box-shadow: var(--lezi); color: var(--ink); text-decoration: none; rotate: -.8deg;
    transition: transform var(--d-stisk) var(--k-stisk);
  }
  .uvodni:hover { transform: translateY(-2px); }
  .uvodni:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .uvodni__nad { color: var(--ink-2); }
  .uvodni__nazev { font-family: var(--font-sans); font-size: var(--fs-ovladani); font-weight: 600; }
  /* Otázky jako řádky zápisníku: číslo rukou, linky tužkou, cesty jako lístky s pahýlem (K6). */
  .otazky { display: grid; gap: 0 var(--s-7); margin: 0; padding: 0; list-style: none; }
  .otazky > li { display: flex; gap: var(--s-4); align-items: baseline; padding: var(--s-5) 0; border-top: 1px dashed var(--tuzka); }
  .cislo { flex: none; width: 2ch; font-family: var(--font-ruka); font-size: var(--fs-ruka-l); line-height: 1; color: var(--ink-2); }
  .text { display: flex; flex-direction: column; gap: var(--s-1); min-width: 0; }
  .text > a { color: var(--ink); text-decoration-color: var(--tuzka); text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
  .text > .t-popisek { color: var(--ink-2); }
  .cesty { display: flex; flex-wrap: wrap; gap: var(--s-4); margin: var(--s-3) 0 0; padding: 0; list-style: none; }
  @media (min-width: 900px) { .otazky { grid-template-columns: 1fr 1fr; } }
</style>
