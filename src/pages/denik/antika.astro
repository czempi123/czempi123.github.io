---
// Tvoje antika: deník na konci období 1 a 2. Studentovy odpovědi po velkých otázkách a myslitelé, kteří to viděli
// podobně. Skládá se v prohlížeči z deníku (src/components/ostrovy/TvojeObdobi.svelte); katalog cest a zastánců
// vzniká při sestavení. Vstup z Můj deník a z Kam dál stránky období 2. Pod přehledem oddíl Co ti zůstalo? (denik-v2, K2):
// kvíz z toho, co student v antice prošel.
import Zakladni from '../../layouts/Zakladni.astro';
import TvojeObdobi from '../../components/ostrovy/TvojeObdobi.svelte';
import CoTiZustalo from '../../components/denik/CoTiZustalo.astro';
import { katalogObdobi } from '../../components/denik/_katalog-obdobi';
import { TVOJE_ANTIKA } from '../../lib/tvoje-obdobi';
import { nezlomitelne } from '../../lib/sazba.js';

const { katalog, prvniCesta } = await katalogObdobi([1, 2]);
---
<Zakladni
  titulek={TVOJE_ANTIKA.nazev}
  sekce="denik"
  drobecky={[{ text: 'Můj deník', href: '/denik/' }, { text: TVOJE_ANTIKA.nazev }]}
  zpet={{ href: '/denik/', text: 'Můj deník' }}
  hledat={false}
>
  <div class="stranka ctenarsky obdobi-2">
    <header class="hlava">
      <p class="t-nadtitulek nadtitulek">Můj deník · období 1 a 2</p>
      <div class="titulek"><div class="titulek__list"><h1 class="titulek__jmeno">{TVOJE_ANTIKA.nazev}.</h1></div></div>
      <div><div class="titulek-pruh"><p class="titulek-pruh__papir"><span class="titulek-pruh__text">Tvoje odpovědi, kdo s tebou stál a co ti zůstalo.</span></p></div></div>
      <p class="t-perex perex">{nezlomitelne(TVOJE_ANTIKA.uvod)}</p>
    </header>
    <TvojeObdobi client:load katalog={katalog} obdobi={2} prvniCesta={prvniCesta} />
    <section class="zustalo" id="co-ti-zustalo" aria-labelledby="co-ti-zustalo-nadpis">
      <h2 class="t-h2 zustalo__nadpis" id="co-ti-zustalo-nadpis">{TVOJE_ANTIKA.zustalo.nadpis}</h2>
      <p class="zustalo__uvod">{nezlomitelne(TVOJE_ANTIKA.zustalo.uvod)}</p>
      <CoTiZustalo obdobi={[1, 2]} barva={2} klic="co-ti-zustalo/antika" />
    </section>
  </div>
</Zakladni>

<style>
  .stranka { padding-bottom: var(--s-8); }
  .hlava { padding: var(--s-6) 0 var(--s-2); }
  .nadtitulek { margin: 0 0 var(--s-4); color: var(--p); }
  .perex { margin: var(--s-5) 0 0; }
  .zustalo { margin-top: var(--s-8); padding-top: var(--s-6); border-top: 1px dashed var(--tuzka); }
  .zustalo__nadpis { margin: 0 0 var(--s-3); }
  .zustalo__uvod { margin: 0 0 var(--s-5); }
</style>
