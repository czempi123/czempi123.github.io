---
// Jedna velká myšlenka: ležící list s disciplínou, číslem rukou, titulkem s pointou v kurzívě a výkladem.
interface Props { cislo: number; disciplina: string }
const { cislo, disciplina } = Astro.props;
---
<article class="myslenka papirovy-list">
  <p class="myslenka__nad"><b>{cislo}</b><span class="vizualne-skryte"> · </span><span class="t-nadtitulek">{disciplina}</span></p>
  <h3 class="t-h3 myslenka__titulek"><slot name="titulek" /></h3>
  <slot />
</article>

<style>
  .myslenka {
    display: flex;
    flex-direction: column;
    padding: var(--s-6) var(--s-5) var(--s-5);
    rotate: calc(-.4deg * var(--natoceni));
  }
  .myslenka:nth-child(2n) { rotate: calc(.5deg * var(--natoceni)); }
  .myslenka__nad { display: flex; align-items: baseline; gap: var(--s-3); margin: 0 0 var(--s-2); }
  .myslenka__nad b { font-family: var(--font-ruka); font-size: 22px; font-weight: 700; line-height: 1; color: var(--p); }
  .myslenka__nad .t-nadtitulek { color: var(--ink-3); }
  .myslenka__titulek { margin-bottom: var(--s-4); }
  .myslenka__titulek :global(em) { font-style: inherit; color: inherit; }
  .myslenka :global(p:last-of-type) { margin-bottom: 0; }
  @media (max-width: 699px) { .myslenka { padding: var(--s-5) var(--s-4) var(--s-4); } }
</style>
