---
// Kam dál: dvě až čtyři pokračování, vždy s jasným cílem. Karty jsou ležící papír (.lezi-odkaz, design-v2 K3):
// po najetí se zvednou a srovnají; připravovaná karta je čárkovaná tužkou, bez šipky a bez stínu (.zakazane).
// Položka bez `href` je stránka, která teprve vznikne (cesta celku, než ji dopíše další krok): karta ji jmenuje,
// nikam nevede a nese slovo „připravujeme“ jako připravovaná období v Mapě a čase. Až stránka vznikne, doplň `href`.
import Ikona from '../ui/Ikona.astro';
import { ODDILY } from '../../lib/oddily';
interface Props { odkazy: { href?: string; nadtitulek: string; text: string }[] }
const { odkazy } = Astro.props;
// Název oddílu: nadpis na stránce i položka v obsahu stránky (ObsahProfilu.astro).
const NAZEV = ODDILY.kamDal.nazev;
---
<nav class="kamdal" aria-labelledby={ODDILY.kamDal.kotva} data-oddil={NAZEV} data-oddil-kotva={ODDILY.kamDal.kotva}>
  <h2 class="t-h2" id={ODDILY.kamDal.kotva}>{NAZEV}</h2>
  <ul>
    {odkazy.map((o) => (
      <li>
        {o.href ? (
          <a class="polozka lezi-odkaz" href={o.href}>
            <span class="t-nadtitulek">{o.nadtitulek}</span>
            <span class="text">{o.text}</span>
            <Ikona id="dal" velikost={22} class="sipka" />
          </a>
        ) : (
          <div class="polozka polozka--ceka zakazane">
            <span class="t-nadtitulek">{o.nadtitulek} · připravujeme</span>
            <span class="text">{o.text}</span>
          </div>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .kamdal { margin: var(--s-10) 0 var(--s-9); }
  h2 { margin-bottom: var(--s-6); }
  ul { display: grid; gap: var(--s-5); margin: 0; padding: 0; list-style: none; }
  li { display: flex; }
  li:nth-child(2n) .polozka { --nat: .7deg; }
  .polozka {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--s-1);
    min-height: 124px;
    padding: var(--s-5) var(--s-5) var(--s-4);
    color: var(--ink);
    text-decoration: none;
  }
  .t-nadtitulek { color: var(--ink-3); }
  .text { font-size: 22px; line-height: 1.2; }
  a.polozka:hover .text { text-decoration: underline; text-decoration-color: var(--tuzka); text-decoration-thickness: 1.5px; text-underline-offset: 0.14em; }
  .polozka :global(.sipka) { margin-top: auto; align-self: flex-end; color: var(--ink-2); }
  /* Stránka, která teprve vznikne: čárkovaný okraj a bez šipky, aby rozdíl nestál jen na barvě. */
  .polozka--ceka .t-nadtitulek { color: inherit; }
  @media (max-width: 699px) { .polozka { min-height: 96px; } .text { font-size: 20px; } }
  @media (min-width: 700px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { ul { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); } }
</style>
