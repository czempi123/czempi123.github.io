---
// Blok „Doba a lidé“: generuje se z dat (lide, vztahy, mista), takže se nikdy nerozejde s mapou.
// Mini osa se současníky, výřez mapy, učitelé a žáci, známí, vliv přes texty a kdo navazoval.
// Společný profil předá další osoby (`dalsi`): vztahy obou se sloučí, vztah mezi nimi se nevypíše
// (řekne ho úvodní věta) a u každého člověka stojí, ke komu ze dvojice vztah patří („učitel Kratéta“).
// Jméno člověka, který má vlastní stránku, je odkaz na ni (adresaStranekOsob: Hipparchia vede na společný profil, medailonek na /osobnost/<id>/);
// lidé bez stránky a osoby, o kterých stránka je, zůstávají prostým textem.
// Použití v MDX: <DobaALide osoba={props.osoba} dalsi={props.dalsi}> úvodní věty </DobaALide>
import type { TOsoba, TVztah } from '../../lib/schema';
import { ODDILY } from '../../lib/oddily';
import { adresaStranekOsob } from '../../lib/stranky-osob';
import { vztahyOsoby, kdoNavazoval } from '../../lib/data';
import { zivot } from '../../lib/casy';
import { roleVztahu, skupinyVztahu, LEGENDA_TRADOVANY } from '../../lib/vztahy';
import Mince from '../ui/Mince.astro';
import MiniOsa from './MiniOsa.astro';
import DvaZivoty from './DvaZivoty.astro';
import MiniMapa from './MiniMapa.astro';
import { maZastavky, ZIVOT_NA_MAPE } from '../../lib/zivot-na-mape';
import { zivotOsoby, obdobiProRok } from '../../lib/cas-mapy';
import { zapisAdresu } from '../../lib/adresa-mapy';
import { data } from '../../lib/data';

interface Props { osoba: TOsoba; dalsi?: TOsoba[] }
const { osoba, dalsi = [] } = Astro.props;
// Pod mini mapou odkaz „Přehrát život na mapě“ u lidí se zastávkami (aspoň dvě místa): Mapa a čas v roce narození,
// karta otevřená a fokus na Přehrát; samo se nic nespustí (interaktivita-v2, K2). Ve společném profilu za osobu stránky.
const rokNarozeni = maZastavky(osoba) ? zivotOsoby(osoba)?.od : undefined;
const prehratZivot = rokNarozeni === undefined ? undefined
  : `/mapa/${zapisAdresu({ rok: rokNarozeni, obdobi: osoba.obdobi, osoba: osoba.id, stin: false, zivot: true }, obdobiProRok(data.obdobi, rokNarozeni))}`;
const osoby = [osoba, ...dalsi];
const dvojice = osoby.length > 1;
const naStrance = new Set(osoby.map((o) => o.id));
const adresa = await adresaStranekOsob();
const odkaz = (id: string) => (naStrance.has(id) ? undefined : adresa(id));
const vztahy = osoby.flatMap((ja) =>
  vztahyOsoby(ja.id)
    .filter((v) => !naStrance.has(v.druhy.id))
    .map((v) => ({ ...v, ja })),
);
const retezy = osoby.flatMap((o) => kdoNavazoval(o.id));
// Vliv přes texty a spor na dálku mají vlastní skupiny: „Znali se a přeli se“ smí stát jen nad lidmi,
// kteří se potkali nebo se spolu přít mohli.
// Nadpisy skupin mají rod osoby stránky; u dvojice zůstávají jako dosud.
const skupiny = skupinyVztahu<TOsoba, (typeof vztahy)[number]>(vztahy, !dvojice && !!osoba.zena);
// Popisek s rodem podle toho, kdo je podmět; tradovaný vztah dostane stejné „vypráví se“ jako karta v Mapě a čase.
const role = (v: (typeof vztahy)[number]) => {
  const r = roleVztahu(v.vztah, v.smer, v.naDalku, { ja: v.ja, druhy: v.druhy });
  const s = !dvojice ? r : v.vztah.typ === 'ucitel' ? `${r} ${v.ja.jmeno2 ?? v.ja.jmeno}` : `${v.ja.jmeno}: ${r}`;
  return v.vztah.tradovany ? `${s} · ${LEGENDA_TRADOVANY}` : s;
};
const nadpis = dvojice
  ? `S kým ${osoby.map((o) => o.jmeno).join(' a ')} žili`
  : `S kým ${osoba.jmeno} žil${osoba.zena ? 'a' : ''}`;
// Název oddílu: nadtitulek na stránce i položka v obsahu stránky (ObsahProfilu.astro).
const NAZEV = ODDILY.doba.nazev;
const TYP_CARY: Record<TVztah['typ'], string> = { ucitel: 'plna', 'znali-se': 'teckovana', 'vliv-textem': 'carkovana', polemika: 'vlnovka' };
---
<section class={`doba obdobi-${osoba.obdobi}`} aria-labelledby={ODDILY.doba.kotva} data-oddil={NAZEV} data-oddil-kotva={ODDILY.doba.kotva}>
  <p class="t-nadtitulek nadtitulek">{NAZEV}</p>
  <h2 class="t-h2" id={ODDILY.doba.kotva}>{nadpis}</h2>
  {/* Medailonek úvodní věty nemá (vše z dat): prázdný úvod by jen přidal mezeru. */}
  {Astro.slots.has('default') && <div class="doba__uvod ctenarsky"><slot /></div>}

  <div class="doba__mrizka">
    <div class="doba__osa">
      <h3 class="t-ovladani-l">Současníci</h3>
      <MiniOsa osoba={osoba} dalsi={dalsi} />
      <div class="doba__dva">
        <h3 class="t-ovladani-l">Dva životy</h3>
        <DvaZivoty osoba={osoba} dalsi={dalsi} />
      </div>
    </div>
    <div class="doba__mapa">
      <h3 class="t-ovladani-l">{dvojice ? 'Kde žili' : osoba.zena ? 'Kde žila' : 'Kde žil'}</h3>
      <MiniMapa osoba={osoba} dalsi={dalsi} />
      {prehratZivot && (
        <a class="prehrat-zivot" href={prehratZivot}>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9.5-5.5z" /></svg>
          {ZIVOT_NA_MAPE.odkaz}
        </a>
      )}
    </div>
  </div>

  <div class="doba__vztahy">
    {skupiny.map((s) => (
      <div>
        <h3 class="t-ovladani-l">{s.nazev}</h3>
        <ul class="lide">
          {s.lide.map((v) => (
            <li>
              <Mince osoba={v.druhy} varianta="tint" velikost={40} />
              <span class="lide__text">
                <span class="lide__jmeno">{odkaz(v.druhy.id) ? <a class="jmeno-odkaz" href={odkaz(v.druhy.id)}>{v.druhy.jmeno}</a> : v.druhy.jmeno}</span>
                <span class="t-popisek">
                  <span class={`cara cara--${TYP_CARY[v.vztah.typ]}`} aria-hidden="true"></span>
                  {role(v)}{v.vztah.poznamka ? ` · ${v.vztah.poznamka}` : ''} · {zivot(v.druhy)}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  {retezy.length > 0 && (
    <div class="navazovali">
      <h3 class="t-ovladani-l">Kdo navazoval</h3>
      <ul>
        {retezy.map((r) => (
          <li>{r.lide.map((o, i) => <>{i > 0 && <span class:list={['sipka', { 'sipka--tradice': r.tradovany[i - 1] }]} title={r.tradovany[i - 1] ? 'učitel a žák podle tradice' : 'učitel a žák'}>{r.tradovany[i - 1] ? '⇢' : '→'}</span>}{odkaz(o.id) ? <a class="jmeno-odkaz" href={odkaz(o.id)}>{o.jmeno}</a> : <span class:list={{ ja: naStrance.has(o.id) }}>{o.jmeno}</span>}</>)}</li>
        ))}
      </ul>
      {retezy.some((r) => r.tradovany.some(Boolean)) && <p class="t-popisek legenda">Čárkovaná šipka ⇢: učitel a žák podle antické tradice.</p>}
    </div>
  )}
</section>

<style>
  .doba {
    margin: var(--s-9) 0;
    padding: var(--s-7) 0 var(--s-6);
    border-top: 1px solid var(--ink);
  }
  .nadtitulek { margin: 0 0 var(--s-2); color: var(--pc); }
  .doba__uvod { margin: var(--s-4) 0 var(--s-6); }
  .doba__mrizka { display: grid; gap: var(--s-6); }
  h3 { margin: 0 0 var(--s-3); }
  .doba__dva { margin-top: var(--s-7); }
  .doba__vztahy { display: grid; gap: var(--s-6); margin-top: var(--s-7); }
  .lide { margin: 0; padding: 0; list-style: none; }
  .lide li { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-2) 0; border-bottom: 1px solid var(--rule); }
  .lide__text { display: flex; flex-direction: column; }
  .lide__jmeno { font-size: 19px; line-height: 1.3; }
  .cara { display: inline-block; width: 22px; margin-right: 6px; vertical-align: middle; border-top: 2px solid var(--pc); }
  .cara--teckovana { border-top-style: dotted; }
  .cara--carkovana { border-top-style: dashed; }
  .cara--vlnovka { border-top-style: double; border-top-width: 3px; }
  .navazovali { margin-top: var(--s-7); }
  .navazovali ul { margin: 0; padding: 0; list-style: none; }
  .navazovali li { display: flex; flex-wrap: wrap; align-items: baseline; row-gap: var(--s-1); padding: var(--s-2) 0; border-bottom: 1px solid var(--rule); font-size: 19px; }
  .sipka { margin: 0 var(--s-2); color: var(--pc); font-family: var(--font-sans); }
  .ja { font-weight: 600; }
  /* Odkaz na stránku člověka: tenké podtržení v barvě období, text zůstává inkoustový, takže je tišší
     než nadpis. Inline-block s 2px nahoře a dole dá cíl dotyku aspoň 24 px (19 px × 1,3). */
  .jmeno-odkaz {
    display: inline-block;
    padding-block: 2px;
    text-decoration-line: underline;
    text-decoration-color: var(--pc);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .jmeno-odkaz:hover { text-decoration-thickness: 2px; }
  .legenda { margin-top: var(--s-2); }
  .prehrat-zivot {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    margin-top: var(--s-3);
    padding: 0 var(--s-4);
    border: 1.5px solid var(--ink);
    border-radius: var(--r-xs);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--fs-ovladani);
    font-weight: 600;
    text-decoration: none;
  }
  .prehrat-zivot svg { fill: var(--pc); }
  .prehrat-zivot:hover { background: var(--sunk); }
  @media (min-width: 900px) {
    .doba__mrizka { grid-template-columns: 7fr 5fr; align-items: start; }
    .doba__vztahy { grid-template-columns: repeat(3, 1fr); }
  }
</style>
