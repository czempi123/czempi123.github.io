---
// Karta cesty: pozvánka na cestu z profilu, z otázky nebo ze stránky období. Vede na přehled cesty.
// K5: lístek cesty s pahýlem jako v hlavičce profilu (VstupyOsoby.astro, K3) a na přehledu cesty: hlavní díl
// s razítky lidí, názvem a vstupem, za perforací pahýl s počtem kroků a minutami. Po najetí se pahýl u perforace
// odtrhne (jen transform a průhlednost, --d-stisk); odkazem je celý lístek.
import { getEntry, getCollection } from 'astro:content';
import RazitkoCloveka from '../ui/RazitkoCloveka.astro';
import Ikona from '../ui/Ikona.astro';
import { osoba } from '../../lib/data';
import { nezlomitelne } from '../../lib/sazba.js';

interface Props {
  slug: string;
  nadtitulek?: string;
  /** kam lístek vede (Domů: rovnou krok 1); jinak přehled cesty */
  href?: string;
  /** nadpis lístku místo názvu cesty (Domů: „Nikdo není *moudřejší.*“, kurzíva hvězdičkami) */
  titulek?: string;
  /** velký lístek (Domů): razítka nad textem, větší nadpis */
  velka?: boolean;
  /** malý lístek (Otázky doby, přehled otázek): jen nadtitulek, název a pahýl */
  maly?: boolean;
  class?: string;
}
const { slug, nadtitulek, href, titulek, velka = false, maly = false, class: trida } = Astro.props;
const nadpis = titulek ? nezlomitelne(titulek).split(/\*([^*]+)\*/).map((t, i) => ({ t, kurziva: i % 2 === 1 })) : undefined;
const c = await getEntry('cesty', slug);
if (!c) throw new Error(`Cesta „${slug}“ není v src/content/cesty`);
const pocet = (await getCollection('kroky')).filter((k) => k.data.cesta === slug).length;
const lide = c.data.filozofove.map(osoba);
---
<a class:list={['cesta-karta', `obdobi-${c.data.obdobi}`, { 'cesta-karta--velka': velka, 'cesta-karta--maly': maly }, trida]} href={href ?? `/cesta/${slug}/`}>
  <span class="cesta-karta__hl">
    {!maly && <span class="cesta-karta__razitka" aria-hidden="true">{lide.map((o) => <RazitkoCloveka osoba={o} velikost={56} />)}</span>}
    <span class="cesta-karta__text">
      <span class="t-nadtitulek cesta-karta__nad">{nadtitulek ?? 'Cesta'}{!maly && <span class="vizualne-skryte"> · {pocet} kroků{c.data.minut && ` · asi ${c.data.minut} minut`}</span>}</span>
      <span class="t-h3 cesta-karta__nazev">{nadpis ? nadpis.map((x) => (x.kurziva ? <em>{x.t}</em> : x.t)) : c.data.nazev}</span>
      {maly && <span class="vizualne-skryte"> · {pocet} kroků{c.data.minut && ` · asi ${c.data.minut} minut`}</span>}
      {!maly && <span class="cesta-karta__vstup">{nezlomitelne(c.data.vstup)}</span>}
      {!maly && <span class="cesta-karta__akce">Vydat se na cestu <Ikona id="dal" velikost={20} /></span>}
    </span>
  </span>
  <span class="cesta-karta__pahyl" aria-hidden="true"><span class="cesta-karta__trh"></span><b>{pocet}</b>kroků{c.data.minut && <span>asi {c.data.minut} min</span>}</span>
</a>

<style>
  .cesta-karta {
    display: flex;
    align-items: stretch;
    max-width: var(--ctenarsky-sloupec);
    margin: var(--s-7) 0;
    border-radius: var(--r-ovladani);
    color: var(--ink);
    text-decoration: none;
  }
  .cesta-karta__hl,
  .cesta-karta__pahyl {
    background: var(--plocha);
    box-shadow: var(--vyst);
    transition: transform var(--d-stisk) var(--k-stisk), rotate var(--d-stisk) var(--k-stisk);
  }
  .cesta-karta__hl {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--s-4);
    min-width: 0;
    padding: var(--s-5);
    border-radius: var(--r-ovladani) 0 0 var(--r-ovladani);
  }
  .cesta-karta__razitka { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .cesta-karta__text { display: flex; flex-direction: column; gap: var(--s-2); }
  .cesta-karta__nad { color: var(--p); }
  .cesta-karta__vstup { color: var(--ink-2); font-size: var(--fs-text); line-height: 1.5; }
  /* Akce vypadá jako tiché tlačítko: lístek je odkaz celý a hlavní čin stránky zůstává jinde. */
  .cesta-karta__akce {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--s-2);
    min-height: 44px;
    margin-top: var(--s-2);
    font-family: var(--font-sans);
    font-size: var(--fs-ovladani-l);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: var(--tuzka);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .cesta-karta__pahyl {
    position: relative;
    flex: none;
    width: 92px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 0 6px;
    border-left: 2px dashed var(--linka);
    border-radius: 0 var(--r-ovladani) var(--r-ovladani) 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.3;
    color: var(--ink-2);
    text-align: center;
    transform-origin: 0 0;
  }
  .cesta-karta__pahyl b { font-family: var(--font-serif); font-size: 24px; font-weight: 500; color: var(--p); }
  .cesta-karta__pahyl::before,
  .cesta-karta__pahyl::after { content: ""; position: absolute; left: -11px; width: 20px; height: 20px; border-radius: 50%; background: var(--papir); }
  .cesta-karta__pahyl::before { top: -10px; }
  .cesta-karta__pahyl::after { bottom: -10px; }
  .cesta-karta__hl::after,
  .cesta-karta__trh {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8px;
    background: var(--plocha);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--d-stisk) var(--k-stisk);
  }
  .cesta-karta__hl::after { right: -7px; clip-path: polygon(0 0, 60% 0, 100% 6%, 30% 13%, 85% 20%, 20% 28%, 75% 35%, 35% 43%, 95% 50%, 25% 58%, 80% 66%, 30% 73%, 90% 80%, 20% 88%, 70% 94%, 40% 100%, 0 100%); }
  .cesta-karta__trh { left: -7px; z-index: 1; clip-path: polygon(100% 0, 40% 0, 0 6%, 70% 13%, 15% 20%, 80% 28%, 25% 35%, 65% 43%, 5% 50%, 75% 58%, 20% 66%, 70% 73%, 10% 80%, 80% 88%, 30% 94%, 60% 100%, 100% 100%); }
  @media (hover: hover) {
    .cesta-karta:hover .cesta-karta__hl { transform: translateY(-2px); }
    .cesta-karta:hover .cesta-karta__pahyl { transform: translate(14px, 4px); rotate: calc(2deg * var(--natoceni)); border-left-color: transparent; }
    .cesta-karta:hover .cesta-karta__hl::after,
    .cesta-karta:hover .cesta-karta__trh { opacity: 1; }
    .cesta-karta:hover .cesta-karta__nazev,
    .cesta-karta:hover .cesta-karta__akce { text-decoration-color: var(--ink); }
    .cesta-karta:hover .cesta-karta__nazev { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 0.12em; }
  }
  .cesta-karta:active .cesta-karta__hl { transform: translateY(1px); }
  .cesta-karta:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  /* Telefon: užší pahýl. Od 700 px razítka ve sloupci pevné šířky, ať text ve všech lístcích začíná stejně. */
  @media (max-width: 699px) {
    .cesta-karta__hl { padding: var(--s-4); }
    .cesta-karta__pahyl { width: 64px; font-size: 12px; }
    .cesta-karta__pahyl b { font-size: 20px; }
  }
  @media (min-width: 700px) {
    .cesta-karta:not(.cesta-karta--velka, .cesta-karta--maly) .cesta-karta__hl { flex-direction: row; align-items: flex-start; gap: var(--s-5); padding: var(--s-6); }
    .cesta-karta:not(.cesta-karta--velka, .cesta-karta--maly) .cesta-karta__razitka { flex: 0 0 56px; flex-direction: column; }
  }
  /* Malý lístek (K6): Otázky doby a přehled otázek; jen nadtitulek, název a pahýl. */
  .cesta-karta--maly { display: inline-flex; width: min(320px, 100%); margin: 0; }
  .cesta-karta--maly .cesta-karta__hl { gap: 2px; padding: 12px 16px 14px; }
  .cesta-karta--maly .cesta-karta__nazev { font-size: 19px; line-height: 1.2; }
  .cesta-karta--maly .cesta-karta__pahyl { width: 76px; font-size: 12px; }
  .cesta-karta--maly .cesta-karta__pahyl b { font-size: 20px; }
  /* Velký lístek na Domů (K6): razítka nad textem, nadpis jako pointa cesty, pahýl širší. */
  .cesta-karta--velka { max-width: 560px; margin: 0; }
  .cesta-karta--velka .cesta-karta__hl { gap: var(--s-3); padding: 22px 24px 18px; }
  .cesta-karta--velka .cesta-karta__nazev { font-size: 34px; line-height: 1.08; letter-spacing: -.01em; }
  .cesta-karta--velka .cesta-karta__nazev em { font-style: inherit; color: inherit; }
  .cesta-karta--velka .cesta-karta__nad { color: var(--ink-2); }
  .cesta-karta--velka .cesta-karta__pahyl { width: 108px; }
  .cesta-karta--velka .cesta-karta__pahyl b { font-size: 30px; }
  @media (max-width: 699px) {
    .cesta-karta--velka .cesta-karta__hl { padding: 18px 16px 14px; }
    .cesta-karta--velka .cesta-karta__nazev { font-size: 27px; }
    .cesta-karta--velka .cesta-karta__pahyl { width: 76px; }
    .cesta-karta--velka .cesta-karta__pahyl b { font-size: 24px; }
  }
</style>
