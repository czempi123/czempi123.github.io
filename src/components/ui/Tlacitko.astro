---
// Tlačítka podle design systému (design-v2, K4a): hlavní na plném inkoustu, vedlejší vystouplé, tiché podtržené
// tužkou, textový odkaz. Vzhled a stavy (najetí, stisk, zakázané čárkovaně tužkou) jsou v global.css: tytéž třídy
// .blok__tl jako tlačítka v ostrovech, ať se tlačítko chová všude stejně.
interface Props {
  href?: string;
  varianta?: 'hlavni' | 'vedlejsi' | 'tiche' | 'odkaz';
  typ?: 'button' | 'submit';
  ikona?: string;
  class?: string;
  [k: string]: unknown;
}
const { href, varianta = 'hlavni', typ = 'button', ikona, class: trida, ...zbytek } = Astro.props;
import Ikona from './Ikona.astro';
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={['tlacitko', `tlacitko--${varianta}`, varianta !== 'odkaz' && ['blok__tl', `blok__tl--${varianta}`], trida]}
  href={href}
  type={href ? undefined : typ}
  {...zbytek}
>
  <span><slot /></span>
  {ikona && <Ikona id={ikona} velikost={20} />}
</Tag>

<style>
  .tlacitko--odkaz {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--dotyk);
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-sans);
    font-size: var(--fs-ovladani-l);
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--tuzka);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
</style>
