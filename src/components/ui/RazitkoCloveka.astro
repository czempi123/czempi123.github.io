---
// Razítko člověka (poštovní razítko, design-v2 Po D4) místo mince na stránkách osob: dva soustředné kruhy
// v inkoustu období, po obvodu nahoře jméno a dole roky, mezi nimi dvě tečky, uprostřed atribut ze spritu
// public/ikony/atributy.svg; kdo atribut nemá, má uprostřed razítkové vlnovky (nikdy iniciálu).
// Inkoust je trochu nedotištěný (jedna maska se šumem v global.css pro všechna razítka, ne SVG filtr u každého),
// bez stínu, natočení podle id (src/lib/razitko.ts).
// Pod 48 px obvod s textem mizí a zůstanou kruhy s atributem. CSS .razitko-cloveka je v global.css.
// <RazitkoCloveka osoba={osoba} velikost={72} />  (popis: true = obrázek s popiskem pro čtečku; jinak aria-hidden)
import type { TOsoba } from '../../lib/schema';
import { zivot } from '../../lib/casy';
import { natoceniRazitka, delkaNaObvodu, BEZ_OBVODU_POD } from '../../lib/razitko';

interface Props {
  osoba: Pick<TOsoba, 'id' | 'jmeno' | 'obdobi' | 'atribut' | 'narozen' | 'zemrel' | 'aktivni'>;
  velikost?: number;
  popis?: boolean;
  class?: string;
}
const { osoba, velikost = 72, popis = false, class: trida } = Astro.props;
const a = osoba.atribut;
const bezObvodu = velikost < BEZ_OBVODU_POD;
const roky = zivot(osoba);
// Id oblouků musí být na stránce jedinečné; jedno razítko se smí opakovat (Doba a lidé, Kam dál).
const g = globalThis as { __razitek?: number };
g.__razitek = (g.__razitek ?? 0) + 1;
const id = `rz-${osoba.id}-${g.__razitek}`;
const delkaJmena = delkaNaObvodu(osoba.jmeno, 11);
const delkaRoku = delkaNaObvodu(roky, 9);
const vlnovka = 'M-14 -5c4-3 8 3 12 0s8-3 12 0 8 3 12 0M-14 1c4-3 8 3 12 0s8-3 12 0 8 3 12 0M-14 7c4-3 8 3 12 0s8-3 12 0 8 3 12 0';
const nazev = a ? `${osoba.jmeno} · ${a.nazev}` : osoba.jmeno;
---
<span
  class:list={['razitko-cloveka', `obdobi-${osoba.obdobi}`, { 'razitko-cloveka--bez-obvodu': bezObvodu }, trida]}
  style={`--mv:${velikost}px;--rr:${natoceniRazitka(osoba.id)}deg`}
  role={popis ? 'img' : undefined}
  aria-label={popis ? nazev : undefined}
  aria-hidden={popis ? undefined : 'true'}
  data-razitko={osoba.id}
>
  <svg viewBox="0 0 100 100" focusable="false" aria-hidden="true">
    <defs>
      {!bezObvodu && <path id={`${id}-h`} d="M14 50a36 36 0 0 1 72 0" />}
      {!bezObvodu && <path id={`${id}-d`} d="M6 50a44 44 0 0 0 88 0" />}
    </defs>
    <g>
      <circle class="rz-k" cx="50" cy="50" r="47" stroke-width="3.4" />
      <circle class="rz-k" cx="50" cy="50" r="31" stroke-width="1.8" />
      {!bezObvodu && (
        <>
          <text class="rz-t"><textPath href={`#${id}-h`} startOffset="50%" text-anchor="middle" textLength={delkaJmena} lengthAdjust={delkaJmena ? 'spacingAndGlyphs' : undefined}>{osoba.jmeno}</textPath></text>
          <text class="rz-t rz-r"><textPath href={`#${id}-d`} startOffset="50%" text-anchor="middle" textLength={delkaRoku} lengthAdjust={delkaRoku ? 'spacingAndGlyphs' : undefined}>{roky}</textPath></text>
          <circle class="rz-b" cx="9.5" cy="50" r="1.6" />
          <circle class="rz-b" cx="90.5" cy="50" r="1.6" />
        </>
      )}
      {a
        ? <use class="rz-ik" href={`/ikony/atributy.svg#${a.ikona}`} x="30.2" y="30.2" width="39.6" height="39.6" />
        : <path class="rz-ik" transform="translate(50 50)" d={vlnovka} />}
    </g>
  </svg>
</span>
