---
// Pás období na Domů (design-v2, K6; plátno Domu.dc.html › pas, Po D3 a Po D4): osm odtrhávacích lístků, každý na
// papíře svého období (--pp-N), od souseda oddělený perforací z teček, s ornamentem období nahoře jako slepotisk
// (src/lib/ornamenty.js) do ztracena k názvu. Výseky nahoře a dole a dírky perforace jsou opravdu vykrojené (maska),
// stín má celý pás (drop-shadow), takže jde i do výseků. Po najetí se lístek u perforace natrhne (pootočí se kolem
// horní hrany, --d-listek); lístek bez stránky nese „připravujeme“ a nezvedá se. Na telefonu svisle.
// Malý pás v Mapě a čase je ostrov src/components/mapa/PasObdobi.svelte (K7a).
import { data } from '../../lib/data';
import { ornamenty } from '../../lib/ornamenty.js';
import { rozpeti } from '../../lib/casy';

interface Props {
  aktivni?: number;
  /** odkaz pro lístek (období bez odkazu se vykreslí jako prostý text s „připravujeme“) */
  odkaz?: (id: number) => string | undefined;
  nadpis?: string;
}
const { aktivni, odkaz, nadpis = 'Osm období' } = Astro.props;
const okno = (o: (typeof data.obdobi)[number]) => rozpeti(o.okno.od, o.okno.do, o.id === 8);
---
<nav class="pas-obdobi" aria-label={nadpis}>
  <ol class="pas">
    {data.obdobi.map((o) => {
      const orn = ornamenty.orn(o.id - 1);
      const href = odkaz?.(o.id);
      const Tag = href ? 'a' : 'div';
      return (
        <li class:list={[`obdobi-${o.id}`, { 'pas__brzy': !href }]}>
          <Tag class="pas__a" href={href} aria-current={aktivni === o.id ? 'true' : undefined}>
            <svg class="pas__orn" viewBox="0 0 160 128" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
              <path class="pas__orn-s" d={orn.solid} />
              <path class="pas__orn-l" d={orn.line} />
            </svg>
            <span class="pas__c">{o.id}</span>
            <span class="pas__n">{o.nazev}</span>
            <span class="pas__r t-letopocet">{okno(o)}{!href && <i>připravujeme</i>}</span>
          </Tag>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .pas {
    position: relative;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    rotate: -.3deg;
    filter: var(--pas-stin);
  }
  li {
    --n1: 0px; --n2: 0px; --d1: 0px; --d2: 0px;
    --vykroj:
      radial-gradient(circle at 0 0, #0000 var(--n1), #000 calc(var(--n1) + .5px)),
      radial-gradient(circle at 0 100%, #0000 var(--n1), #000 calc(var(--n1) + .5px)),
      radial-gradient(circle at 100% 0, #0000 var(--n2), #000 calc(var(--n2) + .5px)),
      radial-gradient(circle at 100% 100%, #0000 var(--n2), #000 calc(var(--n2) + .5px)),
      radial-gradient(circle at 0 50%, #0000 var(--d1), #000 calc(var(--d1) + .5px)) 0 12px / 100% 10px repeat-y,
      radial-gradient(circle at 100% 50%, #0000 var(--d2), #000 calc(var(--d2) + .5px)) 0 12px / 100% 10px repeat-y;
    -webkit-mask: var(--vykroj);
    -webkit-mask-composite: source-in;
    mask: var(--vykroj);
    mask-composite: intersect;
    position: relative;
    display: flex;
    color: var(--na-papiru);
    background: linear-gradient(155deg, rgb(255 255 255 / .08) 0%, rgb(255 255 255 / 0) 40%, rgb(0 0 0 / 0) 60%, rgb(0 0 0 / .14) 100%), var(--pp);
    box-shadow: inset 1.5px 1.5px 0 rgb(255 255 255 / .18), inset -2px -3px 6px rgb(0 0 0 / .22);
    text-shadow: 0 1px 0 rgb(0 0 0 / .18);
    transform-origin: 50% 0;
    transition: transform var(--d-listek) var(--k-papir);
  }
  li:first-child { border-radius: var(--r-ovladani) 0 0 var(--r-ovladani); }
  li:last-child { border-radius: 0 var(--r-ovladani) var(--r-ovladani) 0; }
  li + li { --n1: 9px; --d1: 2px; }
  li:not(:last-child) { --n2: 9px; --d2: 2px; }
  li:has(a:hover) { transform: translateY(5px) rotate(2.4deg); z-index: 2; }
  li:nth-child(even):has(a:hover) { transform: translateY(5px) rotate(-2.4deg); }
  li:has(a:active) { transform: translateY(2px) rotate(1deg); }
  li:has([aria-current]) { box-shadow: inset 3px 3px 9px rgb(0 0 0 / .5), inset -2px -2px 5px rgb(255 255 255 / .14); }
  .pas__a { position: relative; display: flex; flex-direction: column; gap: 6px; width: 100%; min-height: 250px; padding: 12px 16px 20px; color: inherit; text-decoration: none; overflow: hidden; }
  a.pas__a:focus-visible { outline: 2px solid var(--na-papiru); outline-offset: -6px; }
  .pas__orn {
    display: block;
    width: calc(100% + 32px);
    height: 126px;
    margin: -12px -16px -2px;
    -webkit-mask-image: linear-gradient(180deg, #000 0, #000 50%, transparent 96%);
    mask-image: linear-gradient(180deg, #000 0, #000 50%, transparent 96%);
    filter: drop-shadow(.8px 1.2px 0 rgb(0 0 0 / .32)) drop-shadow(-.6px -.6px 0 rgb(255 255 255 / .16));
  }
  .pas__orn-s { fill: currentColor; opacity: .2; }
  .pas__orn-l { fill: none; stroke: currentColor; stroke-width: 1.3; opacity: .5; }
  .pas__c { font: 600 13px/1 var(--font-sans); }
  .pas__n { font-size: 20px; line-height: 1.15; letter-spacing: -.005em; text-wrap: balance; }
  .pas__r { margin-top: auto; font: 13px/1.4 var(--font-sans); }
  .pas__r i { display: block; font-style: normal; opacity: .9; }
  @media (max-width: 899px) {
    .pas { grid-template-columns: 1fr; rotate: 0deg; }
    li {
      --vykroj:
        radial-gradient(circle at 0 0, #0000 var(--n1), #000 calc(var(--n1) + .5px)),
        radial-gradient(circle at 100% 0, #0000 var(--n1), #000 calc(var(--n1) + .5px)),
        radial-gradient(circle at 0 100%, #0000 var(--n2), #000 calc(var(--n2) + .5px)),
        radial-gradient(circle at 100% 100%, #0000 var(--n2), #000 calc(var(--n2) + .5px)),
        radial-gradient(circle at 50% 0, #0000 var(--d1), #000 calc(var(--d1) + .5px)) 12px 0 / 10px 100% repeat-x,
        radial-gradient(circle at 50% 100%, #0000 var(--d2), #000 calc(var(--d2) + .5px)) 12px 0 / 10px 100% repeat-x;
      transform-origin: 0 50%;
    }
    li:first-child { border-radius: var(--r-ovladani) var(--r-ovladani) 0 0; }
    li:last-child { border-radius: 0 0 var(--r-ovladani) var(--r-ovladani); }
    li:has(a:hover), li:nth-child(even):has(a:hover) { transform: translateX(5px) rotate(1.2deg); }
    .pas__a { display: grid; grid-template-columns: 96px minmax(0, 1fr); grid-template-rows: auto auto auto; column-gap: 14px; row-gap: 2px; align-items: center; min-height: 76px; padding: 10px 16px 10px 0; }
    .pas__orn { grid-row: 1 / 4; width: 96px; height: 78px; margin: -10px 0; -webkit-mask-image: linear-gradient(90deg, #000 0, #000 55%, transparent 100%); mask-image: linear-gradient(90deg, #000 0, #000 55%, transparent 100%); }
    .pas__n { font-size: 19px; }
    .pas__r { margin-top: 0; }
    .pas__r i { display: inline; margin-left: .6em; }
  }
</style>
