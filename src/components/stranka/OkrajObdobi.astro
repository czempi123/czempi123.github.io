---
// Živý okraj stránky období (design-v2, K6, bod 6): na notebooku od 1240 px vedle čtenářského sloupce záložky oddílů
// na pravé hraně stránky (papír období, aktuální oddíl povytažený) a pod nimi výstřižek „kde jsme“ s místy období,
// který vede na oddíl Na mapě. Na telefonu a užším notebooku okraj není: oddíly jdou po sobě a mapa má vlastní oddíl.
// <OkrajObdobi oddily={[{ kotva, nazev }]} mista={mistaMapy} obdobi={2} mapa="/mapa/?rok=161" />
interface Props {
  oddily: { kotva: string; nazev: string }[];
  mista: { nazev: string }[];
  obdobi: number;
  mapa: string;
}
const { oddily, mista, obdobi } = Astro.props;
const naMape = oddily.find((o) => o.kotva === 'na-mape') ?? oddily[oddily.length - 1];
---
<nav class={`okraj obdobi-${obdobi}`} aria-label="Oddíly stránky" data-okraj>
  <ol class="okraj__zalozky">
    {oddily.map((o) => <li><a class="okraj__zalozka" href={`#${o.kotva}`} data-okraj-kotva={o.kotva}>{o.nazev}</a></li>)}
  </ol>
  {mista.length > 0 && naMape && (
    <a class="okraj__vystrizek" href={`#${naMape.kotva}`}>
      <span class="okraj__kde">kde jsme</span>
      <span class="okraj__mista">{mista.slice(0, 4).map((m) => m.nazev).join(' · ')}</span>
    </a>
  )}
</nav>

<script>
  // Povytažená záložka oddílu, který student právě čte (horní třetina okna).
  const okraj = document.querySelector<HTMLElement>('[data-okraj]');
  if (okraj && 'IntersectionObserver' in window) {
    const zalozky = [...okraj.querySelectorAll<HTMLAnchorElement>('[data-okraj-kotva]')];
    const oddily = zalozky.map((z) => document.getElementById(z.dataset.okrajKotva!)).filter((x): x is HTMLElement => !!x);
    const viditelne = new Set<string>();
    const obnov = () => {
      const ted = oddily.find((o) => viditelne.has(o.id))?.id;
      zalozky.forEach((z) => (z.dataset.okrajKotva === ted ? z.setAttribute('aria-current', 'location') : z.removeAttribute('aria-current')));
    };
    const pozorovatel = new IntersectionObserver((zaznamy) => {
      zaznamy.forEach((z) => (z.isIntersecting ? viditelne.add(z.target.id) : viditelne.delete(z.target.id)));
      obnov();
    }, { rootMargin: '-15% 0px -60% 0px' });
    oddily.forEach((o) => pozorovatel.observe(o));
  }
</script>

<style>
  .okraj { display: none; }
  @media (min-width: 1240px) {
    .okraj {
      position: fixed;
      top: calc(var(--hlavicka, 76px) + var(--s-7));
      right: 0;
      z-index: 5;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: var(--s-6);
      width: min(220px, calc((100vw - var(--ctenarsky-sloupec)) / 2 - var(--s-6)));
    }
    .okraj__zalozky { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; margin: 0; padding: 0; list-style: none; }
    /* Záložka: papír období zastrčený pod pravou hranou stránky, aktuální oddíl povytažený. */
    .okraj__zalozka {
      display: flex;
      align-items: center;
      min-height: var(--dotyk);
      padding: 6px 22px 6px 14px;
      border-radius: var(--r-ovladani) 0 0 var(--r-ovladani);
      background: linear-gradient(170deg, rgb(255 255 255 / .04), rgb(0 0 0 / .08)), var(--pp);
      color: var(--na-papiru);
      font: 500 14px/1.25 var(--font-sans);
      text-decoration: none;
      text-shadow: 0 1px 0 rgb(0 0 0 / .16);
      box-shadow: inset 1.5px 1.5px 0 rgb(255 255 255 / .16), -2px 2px 4px rgb(0 0 0 / .14);
      transform: translateX(10px);
      transition: transform var(--d-stisk) var(--k-stisk);
    }
    .okraj__zalozka:hover, .okraj__zalozka[aria-current] { transform: none; }
    .okraj__zalozka[aria-current] { font-weight: 600; }
    .okraj__zalozka:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
    /* Výstřižek „kde jsme“: kousek tečkovaného papíru s místy rukou, vede na mapu oddílu Na mapě. */
    .okraj__vystrizek {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-right: var(--s-5);
      padding: 12px 14px 14px;
      background-color: var(--list);
      background-image: radial-gradient(circle at 1px 1px, var(--tecka) 1.1px, transparent 1.4px);
      background-size: 14px 14px;
      box-shadow: var(--lezi);
      color: var(--ink);
      text-decoration: none;
      rotate: calc(2deg * var(--natoceni));
    }
    .okraj__kde { font-family: var(--font-ruka); font-size: var(--fs-ruka); color: var(--p); }
    .okraj__mista { font: 13px/1.45 var(--font-sans); color: var(--ink-2); }
    .okraj__vystrizek:hover .okraj__kde { text-decoration: underline; text-decoration-color: var(--tuzka); text-underline-offset: 3px; }
    .okraj__vystrizek:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  }
  @media print { .okraj { display: none; } }
</style>
