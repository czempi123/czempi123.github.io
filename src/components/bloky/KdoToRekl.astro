---
// Kdo to řekl? (herna-v1, K1): série otočných kartiček s citáty ze zdroje.yaml. Obsah je v src/content/bloky/<id>.yaml (druh: kdo-rekl).
// Použití v MDX: <KdoToRekl id="dilna-kdo-rekl" />  (volitelně dal={{ href, text }})
import Ostrov from '../ostrovy/KdoToRekl.svelte';
import { citatyPodleId, data } from '../../lib/data';
import { moznostiCitatu, puvodCitatu, chybyKdoRekl } from '../../lib/herna';
import { adresaStranekOsob } from '../../lib/stranky-osob';
import { VYCHOZI_NADTITULKY } from '../../lib/nadtitulky';
import { nactiBlok, odkazNaBlok, kamDal, clovek } from './_kontrola';
import type { Dal } from '../ostrovy/bloky-typy';

interface Props { id: string; dal?: Dal }
const { id, dal } = Astro.props;
const blok = await nactiBlok(id, 'kdo-rekl', Astro.url.pathname);
const chyby = chybyKdoRekl(blok.karty, citatyPodleId, new Set(data.lide.map((o) => o.id)));
if (chyby.length) throw new Error(`Blok „${id}“: ${chyby.join(' ')}`);
const adresa = await adresaStranekOsob();
const karty = blok.karty.map((k) => {
  const c = citatyPodleId.get(k.citat)!;
  const spravna = c.osoba!;
  const kdo = clovek(spravna);
  return {
    citat: k.citat,
    veta: c.cesky,
    spravna,
    jmeno: kdo.jmeno,
    puvod: puvodCitatu(c, kdo.jmeno),
    adresa: adresa(spravna),
    napoveda: k.napoveda,
    moznosti: moznostiCitatu(spravna, k.jini, `${id}:${k.citat}`).map((o) => ({ id: o, clovek: clovek(o) })),
  };
});
const dalsi = await kamDal(Astro.url.pathname, dal ?? blok.dal);
const proOstrov = {
  obdobi: blok.obdobi,
  nadtitulek: blok.nadtitulek ?? VYCHOZI_NADTITULKY.KdoToRekl,
  nazev: blok.nazev ?? 'Kdo to řekl?',
  scena: blok.scena,
  otazka: blok.otazka,
  karty,
};
---
<Ostrov client:visible id={id} blok={proOstrov} odkaz={odkazNaBlok(Astro.url.pathname, id)} dal={dalsi} />
